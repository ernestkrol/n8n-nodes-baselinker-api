{
  "name": "n8n-nodes-baselinker-api",
  "version": "0.2.0",
  "description": "n8n node for BaseLinker API with pagination, credentials and flexible parameter inputs",
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "baselinker",
    "ecommerce"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ernestkrol/n8n-nodes-baselinker-api",
  "author": {
    "name": "Ernest Król"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ernestkrol/n8n-nodes-baselinker-api.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-assets.js",
    "build:watch": "tsc --watch",
    "test": "tsx --import ./test/setup.ts --test test/**/*.test.ts",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BaseLinkerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/BaseLinker/BaseLinker.node.js",
      "dist/nodes/BaseLinker/BaseLinkerTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "n8n-workflow": "~2.44.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "isolated-vm@7.0.1": true,
    "ssh2@1.15.0": true
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
